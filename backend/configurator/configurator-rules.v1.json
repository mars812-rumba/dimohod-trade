            "flat"
          ],
          "angle_match": "roof_angle_deg",
          "diameter_match": "selected_sandwich_pipe.outer_diameter_mm",
          "catalog_category_slug": "uzly-prohoda-krovli",
          "catalog_product_slug": "prohodnoy-uzel-krovli-upk-do-45",
