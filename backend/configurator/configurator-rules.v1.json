  "estimate_pdf_contract": {
    "scope": "current_selected_bom_only",
    "removed_lines": "exclude_from_totals_and_list_separately",
    "line_total_formula": "quantity * current_catalog_sku_price_rub",
    "known_subtotal_formula": "sum(line_total_rub where current_catalog_sku_price_rub is confirmed)",
    "missing_price_policy": "show_as_requires_clarification_and_never_invent_or_include_in_known_subtotal",
    "required_sections": [
      "customer_measurements",
      "route_and_selected_layout",
      "bom_with_sku_characteristics",
      "quantity_unit_price_and_line_total",
      "known_price_subtotal",
      "missing_price_count",
      "review_items_and_calculation_errors",
      "generation_timestamp"
    ],
    "document_status": "preliminary_estimate_requires_confirmation",
    "pricing_tiers": {
      "status": "deferred",
