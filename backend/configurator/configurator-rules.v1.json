{
  "schema_version": "1.4.0",
  "updated_at": "2026-08-16",
  "source": {
    "type": "owner_confirmed",
    "status": "active_mvp_with_review_gates",
    "note": "Правила подтверждены владельцем проекта. Неполные технические параметры явно помечены как требующие ввода или последующего подтверждения."
  },
  "svg_generation_contract": "svg-route-generation-rules.v1.json",
  "units": {
    "length": "mm",
    "angle": "deg",
    "quantity": "pcs"
  },
  "catalog_matching": {
    "smoke_channel_components": {
      "diameter_field": "diameter_mm",
      "rule": "equal_to_appliance_outlet_diameter"
    },
    "sandwich_outer_clamps": {
      "diameter_field": "outer_diameter_mm",
      "rule": "equal_to_selected_sandwich_pipe_outer_diameter"
    },
    "sandwich_insulation": {
      "field": "insulation_mm",
      "required_value": 50
    },
    "selection_policy": "structured_fields_only"
  },
  "material_selection_defaults": {
    "visible_chimney_components": {
      "preferred_material": "stainless",
      "preferred_steel_grade": "AISI 304",
      "sandwich_outer_pipe_preferred_material": "stainless",
      "sandwich_outer_pipe_preferred_steel_grade": "AISI 304",
      "selection_mode": "soft_preference_with_catalog_fallback",
      "fallback_rule": "If the requested stainless standard execution is absent, keep the available real SKU and do not invent a variant."
    },
    "catalog_default_exceptions": {
      "component_keys": [
        "ceiling-passage",
        "wall-passage"
      ],
      "product_kinds": [
        "крепеж",
        "изоляция"
      ],
      "examples": [
        "проходной стакан",
        "хомут",
        "скрытый крепёж"
      ]
    }
  },
  "scheme_generation": {
    "format": "svg",
    "orientation": "portrait_mobile_first",
    "geometry": {
      "coordinate_source": "measurements_mm",
      "scale_mode": "single_uniform_scale",
      "preserve_proportions": true,
      "independent_axis_scaling_allowed": false,
      "render_actual_roof_angle": true,
      "roof_angle_input": "roof_angle_deg",
      "ridge_height_input": "ridge_height_mm",
      "ridge_height_datum": "outer_highest_point",
      "ridge_horizontal_distance_input": "ridge_horizontal_distance_mm",
      "ridge_height_required_for_vertical_route": true,
      "ridge_horizontal_distance_required_for_pitched_roof": true,
      "termination_to_ridge_relation": "termination_height_mm - ridge_height_mm",
      "termination_minimum_formula": "max(roof_requirement_mm, grate_height_mm + 5000)",
      "ridge_clearance_branches": [
        "distance <= 1500: ridge_height_mm + 500",
        "1500 < distance <= 3000: ridge_height_mm",
        "distance > 3000: ridge_height_mm - distance * tan(10deg)"
      ]
    },
    "requirements": [
      "Каждый участок трассы строится по фактическим замерам в миллиметрах.",
      "Длины труб и координаты проходных узлов отображаются пропорционально.",
      "Конёк строится по абсолютной высоте от чистового пола; рабочая трасса располагается на левом скате, правый скат показывается пунктиром.",
      "Каждый элемент схемы должен иметь связь с соответствующей строкой BOM.",
      "На схеме обозначаются стыки труб, проходные узлы и точки крепления."
    ]
  },
  "joint_constraints": [
    {
      "id": "no_joint_inside_floor_passage",
      "status": "active",
      "severity": "hard_error",
      "zone": "floor_passage",
      "interval": {
        "start": "finished_ceiling_level_mm",
        "end": "finished_ceiling_level_mm + floor_thickness_mm",
        "boundary_joints_allowed": true
      },
      "rule": "pipe_joint_mm must not be strictly inside the passage interval",
      "message": "Стык трубы не может находиться внутри перекрытия."
    },
    {
      "id": "no_joint_inside_wall_passage",
      "status": "active",
      "severity": "hard_error",
      "zone": "wall_passage",
      "interval": {
        "start": "wall_inner_face_mm",
        "end": "wall_inner_face_mm + wall_thickness_mm",
        "boundary_joints_allowed": true
      },
      "rule": "pipe_joint_mm must not be strictly inside the passage interval",
      "message": "Стык трубы не может находиться внутри стены."
    }
  ],
