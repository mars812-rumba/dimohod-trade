          "catalog_category_slug": "uzly-prohoda-sten-i-perekrytiy",
          "catalog_product_slug": "homut-v-perekrytie"
        },
        {
          "component_role": "insulation_kit",
          "product_kind": "изоляция",
          "quantity": {
            "mode": "manual_input",
