          "product_kind": "декоративная_юбка",
          "quantity_per_passage": 1,
          "diameter_match": "selected_sandwich_pipe.outer_diameter_mm",
          "included_by_default": true,
          "user_removable": true
        },
        {
          "component_role": "decorative_skirt_lower",
          "catalog_name": "Декоративная юбка",
          "product_kind": "декоративная_юбка",
