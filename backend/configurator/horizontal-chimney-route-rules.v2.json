    },
    "decorative_skirt_catalog": "/catalog/uzly-prohoda-sten-i-perekrytiy"
  },
  "sandwich_pipe_media_groups_mm": {
    "photo_1": [1000],
    "photo_2": [150, 250, 350],
    "photo_3": [500, 750]
  }
}
