[Unit]
Description=Telegram Codex gateway for Dimohod Trade
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/codex-bot
EnvironmentFile=/home/codex-bot/.env
Environment=PYTHONUNBUFFERED=1
Environment=DIMOHOD_GIT_BRANCH=recovery/catalog-without-old-db
Environment=DIMOHOD_REMOTE_DEPLOY_HOST=
Environment=PATH=/home/dimohod-production-runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CODEX_BOT_PROJECT_ROOT=/home/dimohod-recovery
Environment=CODEX_BOT_CODEX_BINARY=/home/codex-bot/tools/codex_telegram_bot/codex-launcher.sh
ExecStartPre=/usr/bin/python3 /home/codex-bot/check-config.py
ExecStart=/usr/bin/python3 -m tools.codex_telegram_bot.bot
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/codex-bot /home/dimohod-trade /home/dimohod-recovery /root/.codex /home/sunny-rentals
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
