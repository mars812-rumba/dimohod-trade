[Unit]
Description=Dimohod Trade Telegram Codex Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/dimohod-trade
ExecStart=/usr/bin/python3 -m tools.codex_telegram_bot.bot
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=CODEX_BOT_CODEX_BINARY=/usr/local/bin/codex

# Codex needs its state/workspace; Docker Buildx needs its activity metadata.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dimohod-trade /root/.codex /root/.docker/buildx/activity /root/.docker/buildx/refs
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
