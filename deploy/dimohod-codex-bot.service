[Unit]
Description=Dimohod Trade Telegram Codex Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/dimohod-trade
ExecStart=/usr/bin/python3 -m tools.codex_telegram_bot.bot
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=CODEX_BOT_CODEX_BINARY=/home/dimohod-trade/tools/codex_telegram_bot/codex-launcher.sh

# Codex needs its state/workspace; release commands need the Docker socket and
# Docker/Buildx client state. The Docker daemon itself remains a separate service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/dimohod-trade /home/sunny-rentals /root/.codex /root/.docker /run/docker.sock /var/run/docker.sock
PrivateDevices=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
